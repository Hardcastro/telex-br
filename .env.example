# Copie para .env e preencha o que for usar. Nenhuma dessas variáveis é
# obrigatória para rodar `python -m src.pipeline --demo` ou o pipeline real
# só com RSS + BCB — elas ligam funcionalidades opcionais (ver README).

# Proxy de "réplica" via Reddit (score.py) — crie um app em
# https://www.reddit.com/prefs/apps (tipo "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=telexbr/1.0 by SEU_USUARIO

# Indicadores extras do IBGE/SIDRA (collect.py::fetch_ibge_indicator) —
# preencha depois de confirmar o código exato da tabela em
# https://sidra.ibge.gov.br/
IBGE_PIB_TABLE=
IBGE_PIB_VARIABLE=
IBGE_DESEMPREGO_TABLE=
IBGE_DESEMPREGO_VARIABLE=
